CREATE TABLE Subject (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL
);

CREATE TABLE FlashCard(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  front TEXT NOT NULL,
  back  TEXT NOT NULL,
  subject_id INTEGER NOT NULL DEFAULT 1
);

insertCard:
INSERT INTO FlashCard(front, back)
VALUES (?, ?);

insertCardWithSubject:
INSERT INTO FlashCard(subject_id, front, back)
VALUES (?, ?, ?);

insertSubject:
INSERT INTO Subject(name)
VALUES (?);

selectAllCards:
SELECT id, front, back FROM FlashCard
ORDER BY id DESC;

selectCardsBySubject:
SELECT id, front, back FROM FlashCard
WHERE subject_id = ?
ORDER BY id DESC;

selectCardById:
SELECT id, front, back FROM FlashCard
WHERE id = ?;

selectAllSubjects:
SELECT id, name FROM Subject ORDER BY id DESC;

removeAllCards:
DELETE FROM FlashCard;

-- ABCD tables: questions and their answers
CREATE TABLE ABCDQuestion(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  subject_id INTEGER NOT NULL DEFAULT 1,
  question TEXT NOT NULL
);

CREATE TABLE ABCDAnswer(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  question_id INTEGER NOT NULL,
  question_type INTEGER NOT NULL DEFAULT 0, -- 0 = ABCDQuestion, 1 = ABCDImageQuestion, 2 = Input, 3 = InputImage
  answer TEXT NOT NULL,
  is_correct INTEGER NOT NULL DEFAULT 0
);

insertAbcdQuestion:
INSERT INTO ABCDQuestion(subject_id, question)
VALUES (?, ?);

selectLatestAbcdQuestionId:
SELECT id FROM ABCDQuestion ORDER BY id DESC LIMIT 1;

insertAbcdAnswer:
INSERT INTO ABCDAnswer(question_id, question_type, answer, is_correct)
VALUES (?, ?, ?, ?);

selectAbcdQuestionsBySubject:
SELECT id, question FROM ABCDQuestion WHERE subject_id = ? ORDER BY id DESC;

selectAbcdQuestionById:
SELECT id, question FROM ABCDQuestion WHERE id = ?;

selectAbcdAnswersByQuestion:
SELECT id, answer, is_correct FROM ABCDAnswer WHERE question_id = ? AND question_type = ?;

selectCorrectAbcdAnswersIdsByQuestion:
SELECT id FROM ABCDAnswer WHERE question_id = ? AND question_type = ? AND is_correct = 1;

CREATE TABLE ABCDImageQuestion(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  subject_id INTEGER NOT NULL DEFAULT 1,
  question TEXT NOT NULL,
  image_src TEXT NOT NULL
);

insertAbcdImageQuestion:
INSERT INTO ABCDImageQuestion(subject_id, question, image_src)
VALUES (?, ?, ?);

selectABCDImageQuestionsBySubject:
SELECT id, question, image_src FROM ABCDImageQuestion WHERE subject_id = ? ORDER BY id DESC;


selectLatestABCDImageQuestionId:
SELECT id FROM ABCDImageQuestion ORDER BY id DESC LIMIT 1;

CREATE TABLE InputQuestion (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  question_type INTEGER NOT NULL DEFAULT 0, -- 0 = input, 1 = imageInput
  question TEXT NOT NULL,
  image_src TEXT,
  subject_id INTEGER NOT NULL
);

insertInputQuestion:
INSERT INTO InputQuestion(subject_id, question, image_src, question_type)
VALUES (?, ?, ?, ?);

selectAllInputQuestions:
SELECT id, question_type, question, image_src, subject_id FROM InputQuestion
ORDER BY id DESC;

selectLastInputQuestions:
SELECT id, question_type, question, image_src, subject_id FROM InputQuestion
ORDER BY id DESC LIMIT 1;

selectInputByType:
SELECT id, question_type, question, image_src, subject_id FROM InputQuestion
WHERE subject_id = ? AND question_type = ?
ORDER BY id DESC;

selectLatestInputQuestionId:
SELECT id FROM InputQuestion ORDER BY id DESC LIMIT 1;

CREATE TABLE InputAnswer (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  input_question_id INTEGER NOT NULL,
  answer TEXT NOT NULL,
  FOREIGN KEY (input_question_id) REFERENCES InputQuestion(id)
);

insertInputAnswer:
INSERT INTO InputAnswer(input_question_id, answer)
VALUES (?, ?);

selectAnswersForInputQuestion:
SELECT id, answer FROM InputAnswer
WHERE input_question_id = ?;

selectAllInputQuestionsByType:
SELECT id, question_type, question, image_src, subject_id FROM InputQuestion
WHERE question_type = ? AND subject_id = ?
ORDER BY id DESC;