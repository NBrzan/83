CREATE TABLE Subject (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL
);

CREATE TABLE FlashCard(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  front TEXT NOT NULL,
  back  TEXT NOT NULL,
  subject_id INTEGER NOT NULL DEFAULT 1
);

insertCard:
INSERT INTO FlashCard(front, back)
VALUES (?, ?);

insertCardWithSubject:
INSERT INTO FlashCard(subject_id, front, back)
VALUES (?, ?, ?);

insertSubject:
INSERT INTO Subject(name)
VALUES (?);

selectAllCards:
SELECT id, front, back FROM FlashCard
ORDER BY id DESC;

selectCardsBySubject:
SELECT id, front, back FROM FlashCard
WHERE subject_id = ?
ORDER BY id DESC;

selectCardById:
SELECT id, front, back FROM FlashCard
WHERE id = ?;

selectAllSubjects:
SELECT id, name FROM Subject ORDER BY id DESC;

removeAllCards:
DELETE FROM FlashCard;

-- ABCD tables: questions and their answers
CREATE TABLE ABCDQuestion(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  subject_id INTEGER NOT NULL DEFAULT 1,
  question TEXT NOT NULL
);

CREATE TABLE ABCDAnswer(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  question_id INTEGER NOT NULL,
  answer TEXT NOT NULL,
  is_correct INTEGER NOT NULL DEFAULT 0
);

insertAbcdQuestion:
INSERT INTO ABCDQuestion(subject_id, question)
VALUES (?, ?);

-- helper to read the last inserted question id (used inside transaction)
selectLatestAbcdQuestionId:
SELECT id FROM ABCDQuestion ORDER BY id DESC LIMIT 1;

insertAbcdAnswer:
INSERT INTO ABCDAnswer(question_id, answer, is_correct)
VALUES (?, ?, ?);

selectAbcdQuestionsBySubject:
SELECT id, question FROM ABCDQuestion WHERE subject_id = ? ORDER BY id DESC;

selectAbcdQuestionById:
SELECT id, question FROM ABCDQuestion WHERE id = ?;

selectAbcdAnswersByQuestion:
SELECT id, answer, is_correct FROM ABCDAnswer WHERE question_id = ?;

selectCorrectAbcdAnswersIdsByQuestion:
SELECT id FROM ABCDAnswer WHERE question_id = ? AND is_correct = 1;